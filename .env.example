# E2B
E2B_API_KEY=
E2B_TEMPLATE_NAME=tidbcloud-fs-workspace-dev

# LLM (any OpenAI-compatible endpoint; defaults target Z.ai GLM-5.2)
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-5.2

# TiDB Cloud Filesystem. Provision once from a `ti configure`'d machine, then
# copy the one-time fs_token into TI_FS_TOKEN below. ti derives the filesystem
# ID from this token, so the sandbox needs no TiDB Cloud API keys, profile files,
# filesystem name, or explicit filesystem ID.
#   ti configure --non-interactive --region-code aws-ap-southeast-1 \
#     --tidb-cloud-public-key <key> --tidb-cloud-private-key <key>
#   ti fs create-file-system --wait --query fs_token --output text
TI_REGION_CODE=aws-ap-southeast-1
TI_FS_TOKEN=

# Optional: override where template.ts downloads the pinned v0.2.3 installer.
# TI_INSTALL_URL=

# Z.ai GLM Coding Plan subscribers: use the coding endpoint instead:
# LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
