# E2B
E2B_API_KEY=
E2B_TEMPLATE_NAME=tidbcloud-fs-workspace-dev

# LLM (any OpenAI-compatible endpoint; defaults target Z.ai GLM-5.2)
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-5.2

# TiDB Cloud FS. Provision once with a `ti configure`'d machine, then copy the
# fs_token it prints into TI_FS_TOKEN below — no TiDB Cloud public/private
# keys or ~/.ti/ profile files are needed to run this demo after that.
#   ti configure --non-interactive --region-code aws-us-east-1 \
#     --public-key <key> --private-key <key>
#   ti fs create-file-system --display-name workspace \
#     --query fs_token --output text
TI_REGION_CODE=aws-us-east-1
TI_FS_FILE_SYSTEM_NAME=workspace
TI_FS_TOKEN=

# Optional: override where template.ts downloads the ti installer from
# (defaults to the latest GitHub release).
# TI_INSTALL_URL=

# Z.ai GLM Coding Plan subscribers: use the coding endpoint instead:
# LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
