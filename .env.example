# E2B
E2B_API_KEY=
E2B_TEMPLATE_NAME=tidbcloud-fs-workspace-dev

# LLM (any OpenAI-compatible endpoint; defaults target Z.ai GLM-5.2)
LLM_API_KEY=
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-5.2

# TiDB Cloud FS. Provision once with a `tdc configure`'d machine, then copy the
# fs_token it prints into TDC_FS_TOKEN below — no TiDB Cloud public/private
# keys or ~/.tdc/ profile files are needed to run this demo after that.
#   tdc configure --non-interactive --region-code aws-us-east-1 \
#     --tdc-public-key <key> --tdc-private-key <key>
#   tdc fs create-file-system --file-system-name workspace \
#     --query fs_token --output text
TDC_REGION_CODE=aws-us-east-1
TDC_FS_FILE_SYSTEM_NAME=workspace
TDC_FS_TOKEN=

# Optional: override where template.ts downloads the tdc installer from
# (defaults to the latest GitHub release).
# TDC_INSTALL_URL=

# Z.ai GLM Coding Plan subscribers: use the coding endpoint instead:
# LLM_BASE_URL=https://api.z.ai/api/coding/paas/v4
